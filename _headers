# Cloudflare Pages — Cache-Control headers
# الهدف: HTML و service-worker دائماً طازجة، الأصول المُهَشَّمة كاش طويل.

# Service Worker: يجب يُفحَص في كل زيارة (وإلا النسخة القديمة تبقى للأبد)
# no-cache (لا max-age=0 وحده): Cloudflare يكتب max-age فوق قيمتنا بإعداد
# Browser Cache TTL على مستوى النطاق، لكنه يُبقي بقية التوجيهات — وno-cache
# يُلزم المتصفّح بالتحقّق قبل الاستخدام مهما كان الرقم.
/service-worker.js
  Cache-Control: public, no-cache, must-revalidate
  Service-Worker-Allowed: /

# صفحات HTML الجذر: دائماً طازجة
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/app.html
  Cache-Control: public, max-age=0, must-revalidate

/book.html
  Cache-Control: public, max-age=0, must-revalidate

/card.html
  Cache-Control: public, max-age=0, must-revalidate

# صفحات الـ auth و admin
/auth/*
  Cache-Control: public, max-age=0, must-revalidate

/admin/*
  Cache-Control: public, max-age=0, must-revalidate

# ملفات JS غير المُهَشَّمة (vanilla JS مكتوبة كـ window globals).
# أسماؤها ثابتة عبر النشرات، فأي max-age يعني كوداً قديماً بعد الرفع —
# no-cache يجعلها تُتحقَّق دائماً (رد 304 رخيص) بدل أن تعلق 4 ساعات.
# البناء يضيف ?v=<hash> فوق ذلك، فالرابط نفسه يتغيّر مع كل نشر.
/src/*
  Cache-Control: public, no-cache, must-revalidate

# ملفّا ربط النطاق بالتطبيقين (Universal Links / App Links).
# apple-app-site-association بلا امتداد، فتخدمه Cloudflare كـ octet-stream —
# وأبل ترفضه صامتةً بلا نوع JSON، فتفتح الروابط في المتصفّح ولا يظهر أي خطأ
# يدلّك على السبب. الكاش قصير كي يسري تصحيحُ البصمة في ساعة لا في سنة.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# مكتبات الطرف الثالث: كاش سنة كاملة. أسماؤها ثابتة لكن البناء يُلحق بصمة محتوى
# (?v=<sha256>) بكل وسم script، فالرابط يتغيّر عند ترقية المكتبة فقط — وهذا هو
# الشرط الذي يجعل immutable آمناً هنا.
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Manifest و config — كاش قصير
/manifest.webmanifest
  Cache-Control: public, max-age=3600

/config.js
  Cache-Control: public, no-cache, must-revalidate

# ملاحظة: ملفات /assets/* المُهَشَّمة بواسطة Vite (مثل main-XXXXX.css)
# تحصل تلقائياً على max-age=31536000 من Cloudflare Pages — لا حاجة لتعديل.
