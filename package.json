{
  "name": "marma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/sync-vendor.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && node scripts/generate-config.js && vite build",
    "preview": "vite preview",
    "test": "node test/pricing.test.js && node test/install-target.test.js",
    "db": "sh scripts/db.sh",
    "build:native": "node scripts/build-native.mjs",
    "build:native:ios": "node scripts/build-native.mjs ios",
    "build:native:android": "node scripts/build-native.mjs android",
    "ios": "npm run build:native:ios && npx cap run ios",
    "android": "npm run build:native:android && npx cap run android",
    "ios:open": "npm run build:native:ios && npx cap open ios",
    "android:open": "npm run build:native:android && npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@supabase/supabase-js": "2.86.0",
    "fullcalendar": "6.1.19",
    "jsqr": "1.4.0",
    "lucide": "0.548.0",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  }
}
