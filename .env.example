# انسخ هذا الملف إلى .env وضع القيم الحقيقية. .env متجاهَل في git.
# بعد إنشائه: chmod 600 .env
#
# القيم من لوحة Supabase:
#   Project Settings ← Database ← Connection string ← Session pooler
#
# استخدم Session pooler لا Direct connection: الأخير عبر IPv6 فقط
# ويفشل على أغلب شبكات المنازل ومزوّدي الإنترنت المحليين.
#
# كلمة المرور تُكتب حرفيّاً كما هي — بلا ترميز URL. إن كانت تحوي @ أو # أو %
# فاكتبها كما هي ولا تحوّلها إلى %40 أو %23. نسيتها؟ صفّرها من:
#   Project Settings ← Database ← Reset database password
#
# لا تسبق أيّ اسم بـ VITE_ أبداً — تلك البادئة تحقن المتغيّر في حزمة المتصفّح.

SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_USER=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=

# اختياريّان — القيم الافتراضية أدناه تكفي في أغلب الحالات.
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
