# Local config (يحتوي على credentials)
config.js

# Apple Sign in — المفتاح الخاص (لا يُرفع أبداً)
*.p8

# شهادات ومفاتيح بطاقات المحفظة (Pass Type ID / APNs / Google SA)
# المفتاح الخاص لشهادة الـ Pass = القدرة على إصدار بطاقات باسمك. لا يُرفع أبداً.
certs/
*.key
*.csr
*.cer
*.pem
*.p12
*.pfx
google-service-account*.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (لو أضفنا build لاحقاً)
dist/
build/
node_modules/

# حزمة الويب الخاصة بالتطبيق الأصلي (MARMA_TARGET=native) — مولَّدة، وCapacitor
# ينسخها إلى ios/App/App/public و android/.../assets/public عند كل cap sync.
dist-native/

# مخرجات PWA من @capacitor/assets — لا يشير إليها شيء (أيقونات الويب في assets/pwa)
icons/

# مكتبات الطرف الثالث المنسوخة من node_modules (scripts/sync-vendor.mjs).
# مولَّدة عند كل بناء من الإصدارات المثبَّتة في package.json — لا تُلتزم كي لا
# تتباعد عن التبعيات أبداً. qrcode.min.js وحده مُلتزم (لا حزمة npm له).
assets/vendor/lucide.min.js
assets/vendor/supabase.js
assets/vendor/fullcalendar.global.min.js
assets/vendor/fullcalendar-locale-ar.global.min.js
assets/vendor/jsQR.js
assets/vendor/VERSIONS.json

# Environment
.env
.env.local
.env.*.local

# Claude Code MCP config (contains secrets)
.mcp.json

# Temp
*.tmp
*.bak
supabase/.temp/

# Wrangler local dev cache (npx wrangler pages dev)
.wrangler/
